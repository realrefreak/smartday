# Copy this file to .env.local and fill in real values.
# .env.local is ignored by Git; this example file is committed so everyone
# knows which variables the app needs. Never put real secrets in this file.

# Postgres connection string from Neon (Dashboard -> Connect).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
