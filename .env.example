# Copy this file to .env.local and fill in real values.
# .env.local is ignored by Git; this example file is committed so everyone
# knows which variables the app needs. Never put real secrets in this file.

# Postgres connection string from Neon (Dashboard -> Connect).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies so they can't be forged. Long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Where the app is running. In production, your real https:// address.
BETTER_AUTH_URL="http://localhost:3000"

# Sentry error tracking (optional locally: leave empty and nothing is sent).
# Production sets it in Vercel. Not a secret: it ends up in the browser code.
NEXT_PUBLIC_SENTRY_DSN=""

# A SEPARATE database used only by tests (e.g. a Neon branch named "test").
# Tests delete all tasks in it. Must not be the same as DATABASE_URL.
# Optional: without it, database tests are skipped.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Lets `npm run test:preview` (and the preview-and-ship agent) get past
# Vercel's login on pull request previews. Vercel > smartday > Settings >
# Deployment Protection > Protection Bypass for Automation. Optional otherwise.
VERCEL_AUTOMATION_BYPASS_SECRET=""

# Daily email reminders (optional locally: without RESEND_API_KEY emails are
# only logged, never sent). Production sets these in Vercel.
# RESEND_API_KEY: resend.com > API Keys. Treat it like a password.
RESEND_API_KEY=""
# Who the email is from. Leave empty to use Resend's test sender, which can
# only email the address you signed up to Resend with.
REMINDER_FROM_EMAIL=""
# The password the hourly GitHub workflow uses to call /api/cron/reminders.
# Same value in Vercel (Production) and GitHub (environment "production").
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
