# Copy this file to .env.local and fill in real values.
# .env.local is ignored by Git; this example file is committed so everyone
# knows which variables the app needs. Never put real secrets in this file.

# Postgres connection string from Neon (Dashboard -> Connect).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# A SEPARATE database used only by tests (e.g. a Neon branch named "test").
# Tests delete all tasks in it. Must not be the same as DATABASE_URL.
# Optional: without it, database tests are skipped.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
